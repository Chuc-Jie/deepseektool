{
  "manifest_version": 3,
  "name": "DeepSeek 功能增强工具箱",
  "short_name": "DS 工具箱",
  "version": "0.1.0",
  "description": "DeepSeek 对话页增强：代码块折叠与导出、表格优化与导出、对话导出、思考折叠、文件夹分组、宽屏模式。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "DeepSeek 功能增强工具箱",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
